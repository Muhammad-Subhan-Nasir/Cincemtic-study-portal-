rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Academic Resources & Drive Folders
    match /resources/{resourceId} {
      allow read, write: if true;
    }

    // 2. Portal Announcements & Broadcast Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 3. Visitor Logs & Telemetry
    match /visitor_logs/{logId} {
      allow read, write: if true;
    }

    // 4. Default open policy for universe-of-resources collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
